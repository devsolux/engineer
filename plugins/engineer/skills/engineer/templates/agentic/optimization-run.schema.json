{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineer.local/optimization-run.schema.json",
  "title": "engineer prompt and loop optimization run",
  "type": "object",
  "required": ["schema_version", "experiment_id", "change", "claim", "environment", "datasets", "gates", "evidence", "results", "trace_review", "decision"],
  "properties": {
    "schema_version": {"const": 2},
    "experiment_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "change": {"type": "object"},
    "claim": {
      "type": "object",
      "required": ["estimand", "target", "generalization_claimed", "uncertainty_method", "limitations"],
      "properties": {
        "estimand": {"enum": ["fixed_benchmark_performance", "task_population_performance"]},
        "target": {"type": "string", "minLength": 1},
        "generalization_claimed": {"type": "boolean"},
        "uncertainty_method": {"enum": ["none_fixed_benchmark", "task_cluster_bootstrap", "hierarchical_model"]},
        "limitations": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environment": {"type": "object"},
    "datasets": {"type": "object"},
    "gates": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": ["capture_kind", "path", "sha256", "captured_at", "runner", "attestation"],
      "properties": {
        "capture_kind": {"enum": ["illustrative_fixture", "captured_run"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "runner": {"type": "string", "minLength": 1},
        "attestation": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "results": {"type": "object"},
    "trace_review": {"type": "object"},
    "decision": {"enum": ["promote", "reject"]}
  },
  "additionalProperties": false
}
