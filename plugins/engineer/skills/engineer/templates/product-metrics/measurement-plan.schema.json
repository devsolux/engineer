{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineer.local/measurement-plan.schema.json",
  "title": "engineer product measurement plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "north_star", "metrics", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "north_star": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value_moment"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/id" },
        "value_moment": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "experiments": {
      "type": "array",
      "items": { "$ref": "#/$defs/experiment" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "question", "formula", "grain", "source",
        "segments", "owner", "cadence", "freshness_slo", "decision_rule", "guardrails"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["north_star", "input", "outcome", "guardrail", "diagnostic"] },
        "question": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "grain": { "enum": ["event", "session", "user", "account", "workspace", "subscription"] },
        "source": { "type": "string", "minLength": 1 },
        "segments": { "$ref": "#/$defs/nonEmptyStrings" },
        "owner": { "type": "string", "minLength": 1 },
        "cadence": { "enum": ["realtime", "hourly", "daily", "weekly", "monthly", "quarterly"] },
        "freshness_slo": { "type": "string", "minLength": 1 },
        "decision_rule": { "type": "string", "minLength": 1 },
        "guardrails": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "classification"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "type": { "enum": ["string", "number", "boolean", "integer", "timestamp", "enum", "object"] },
        "required": { "type": "boolean" },
        "classification": { "enum": ["none", "pii", "sensitive", "revenue"] },
        "description": { "type": "string" },
        "enum_values": { "$ref": "#/$defs/nonEmptyStrings" },
        "privacy_basis": { "type": "string", "minLength": 1 },
        "retention_days": { "type": "integer", "minimum": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "description", "version", "source", "criticality", "owner",
        "identities", "properties"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["client", "server"] },
        "criticality": { "enum": ["interaction", "durable", "money", "permission"] },
        "owner": { "type": "string", "minLength": 1 },
        "identities": { "$ref": "#/$defs/nonEmptyStrings" },
        "dedupe_key": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "hypothesis", "randomization_unit", "eligible_cohort", "exposure_event",
        "primary_metric", "guardrails", "decision_rule", "owner"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "hypothesis": { "type": "string", "minLength": 1 },
        "randomization_unit": { "enum": ["user", "account", "workspace"] },
        "eligible_cohort": { "type": "string", "minLength": 1 },
        "exposure_event": { "$ref": "#/$defs/id" },
        "primary_metric": { "$ref": "#/$defs/id" },
        "guardrails": { "$ref": "#/$defs/nonEmptyStrings" },
        "decision_rule": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    }
  }
}
